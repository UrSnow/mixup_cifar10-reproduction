# Python
__pycache__/
*.py[cod]
.venv*/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.env

# Datasets (CIFAR-10 is downloaded on demand)
data/
cifar-10-batches-py/
cifar-10-python.tar.gz

# Training outputs and checkpoints (copy final metrics/figures into results/ deliberately)
runs/
mixup-reproduction-v*/
sample_data/
*.pt
*.pth
*.ckpt
*.tmp

# Generated Colab upload bundle (rebuild with scripts/package_colab.py)
*.zip

# Course material, papers, proposal and slides (copyright / personal details)
*.pdf
*.pptx
*.docx
~$*
# ...except the write-up's generated figure, which the paper needs to compile
!paper/generated/*.pdf

# LaTeX build files (rebuild with scripts/reproduce.py)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz

# Editors and OS
.vscode/
.idea/
.claude/settings.local.json
.DS_Store
Thumbs.db
desktop.ini
